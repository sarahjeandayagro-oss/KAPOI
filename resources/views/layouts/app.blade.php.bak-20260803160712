        <script>
          // Fallback: ensure notification bell works when component stack scripts didn't execute
          document.addEventListener('DOMContentLoaded', function(){
            try {
              var btn = document.getElementById('notifBtn');
              var dropdownWrap = document.getElementById('notificationDropdown');
              if (btn && dropdownWrap && !window.toggleNotifDropdown) {
                btn.addEventListener('click', function(e){ e.stopPropagation(); dropdownWrap.classList.toggle('open'); });
                document.addEventListener('click', function(e){ if(!e.target.closest('.notif-dropdown') && !e.target.closest('#notifBtn')) dropdownWrap.classList.remove('open'); });
                window.toggleNotifDropdown = function(e){ e.stopPropagation(); dropdownWrap.classList.toggle('open'); };
              }
            } catch (err) {}
          });
        </script>
