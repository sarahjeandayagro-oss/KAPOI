    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* WiFi voucher panel removed as feature was deprecated from the staff/admin workflow */
    .sidebar-bottom {
      margin-top: auto;
      padding: 14px 10px;
      border-top: 1px solid var(--border);
