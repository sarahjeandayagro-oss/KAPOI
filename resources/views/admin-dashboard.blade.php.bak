        <script>
          function populateFinancialForm(id, type, userId, patronName, description, amount, status, date) {
            const form = document.querySelector('form[action="{{ route('admin.financial-transactions.store') }}"]');
            if (!form) return;
            document.getElementById('financial-transaction-id').value = id || '';
            // Map legacy types to new 'Fund' option for UX
            const mappedType = (type === 'Fund Income' || type === 'Fund Expense') ? 'Fund' : type;
            form.querySelector('[name="transaction_type"]').value = mappedType || 'Fine';
            form.querySelector('[name="user_id"]').value = userId || '';
            form.querySelector('[name="patron_name"]').value = patronName || '';
            form.querySelector('[name="description"]').value = description || '';
            form.querySelector('[name="amount"]').value = amount || '';
            form.querySelector('[name="status"]').value = status || 'Unpaid';
            form.querySelector('[name="transaction_date"]').value = date || '{{ now()->toDateString() }}';
            window.scrollTo({ top: 120, behavior: 'smooth' });
          }
        </script>
    </div>

